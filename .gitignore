# Research datasets stay local. Keep their documentation versioned.
/data/raw/**
!/data/raw/**/
!/data/raw/**/.gitkeep
!/data/raw/**/*.md
!/data/raw/**/*.[rR]md
!/data/raw/**/*.ipynb
!/data/raw/**/assets/**/*.png
!/data/raw/**/assets/**/*.svg
/data/processed/**
!/data/processed/**/
!/data/processed/**/.gitkeep
!/data/processed/**/*.md
!/data/processed/**/*.[rR]md
!/data/processed/**/*.ipynb
!/data/processed/**/assets/**/*.png
!/data/processed/**/assets/**/*.svg

# Also catch common dataset formats accidentally saved outside data/.
*.[cC][sS][vV]
*.[cC][sS][vV].*
*.[tT][sS][vV]
*.[tT][sS][vV].*
*.[xX][lL][sS]
*.[xX][lL][sS][xX]
*.[pP][aA][rR][qQ][uU][eE][tT]
*.[fF][eE][aA][tT][hH][eE][rR]
*.[dD][tT][aA]
*.[sS][aA][vV]
*.[sS][aA][sS]7[bB][dD][aA][tT]
*.[rR][dD][sS]
*.[rR][dD][aA]
*.[rR][dD][aA][tT][aA]
*.[sS][qQ][lL][iI][tT][eE]
*.[sS][qQ][lL][iI][tT][eE]3
*.[dD][bB]

# Keep transient files excluded even inside documentation directories.
.DS_Store
.ipynb_checkpoints/
**/.ipynb_checkpoints/**
__pycache__/
**/__pycache__/**
*.pyc
.venv/
**/.venv/**
.Rhistory
.RData
.Rproj.user/
**/.Rproj.user/**
data/temp/*
!data/temp/.gitkeep
*.aux
*.fdb_latexmk
*.fls
*.synctex.gz
*.blg
*.bcf
*.run.xml
